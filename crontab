# shellcheck disable=all
PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
SHELL=/bin/bash

# ВАЖНО: HH использует ОДНОРАЗОВЫЕ refresh-токены. Два процесса, стартующих
# одновременно, прочитают один и тот же refresh-токен, и второй упадёт с
# 'token has already been refreshed'. Поэтому задачи РАЗНЕСЕНЫ по минутам,
# чтобы не пересекаться. Не запускай команды вручную, пока работает cron.

# При старте контейнера — прогреть сессию (refresh + первая рассылка).
@reboot /bin/bash /app/startup.sh >> /var/log/cron.log 2>&1

# Поднимать резюме каждые 5 часов (на 15-й минуте).
15 */5 * * * /bin/bash -c 'sleep $((RANDOM \% 60))' && /usr/local/bin/python -m hh_applicant_tool update-resumes >> /var/log/cron.log 2>&1

# Рассылка откликов с AI — на 0-й минуте, в часы работы (8-21 MSK).
# --force-message: письмо на все вакансии. --ai-filter light: AI-отсев.
0 8-21 * * * /bin/bash -c 'sleep $((RANDOM \% 120))' && /usr/local/bin/python -m hh_applicant_tool apply-vacancies --use-ai --force-message --ai-filter light --excluded-filter 'junior|стажировк|bitrix|web3|crypto|blockchain|тестов\w+ задан|soft skill' >> /var/log/cron.log 2>&1

# Ответы работодателям + чистка отказов/блокировок — на 30-й минуте (9-22),
# с полчаса смещением от apply-vacancies, чтобы не делить refresh-токен.
30 9-22 * * * /bin/bash -c 'sleep $((RANDOM \% 60))' && /usr/local/bin/python -m hh_applicant_tool reply-employers --use-ai --only-invitations --delete-discarded --delete-blacklisted >> /var/log/cron.log 2>&1

# Ночная чистка отказов (без AI) — раз в сутки, на 45-й минуте.
45 3 * * * /usr/local/bin/python -m hh_applicant_tool reply-employers --delete-discarded --delete-blacklisted >> /var/log/cron.log 2>&1

# Отдельный refresh-token по крону НЕ нужен: токен обновляется автоматически
# при любом запросе. Принудительный refresh лишь создаёт гонку за одноразовый
# refresh-токен и ломает соседние задачи.
